# Copy to .secrets and fill in your values.
#
# GCP_SA_KEY: Full JSON key of a GCP service account with storage admin access.
#   Create one at: GCP Console -> IAM & Admin -> Service Accounts -> Create Key (JSON)
#
# KUBECONFIG: Base64-encoded kubeconfig of the cluster running Crossplane.
#   Get it with:
#     kubectl config view --minify --raw | base64 -w0
GCP_SA_KEY=<full-service-account-json>
KUBECONFIG=<base64-encoded-kubeconfig>